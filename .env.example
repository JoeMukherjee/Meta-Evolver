# Meta-Evolver reads these at import time via a dependency-free .env loader.

# One of these is required for Gemini (the default provider).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Any other litellm-supported provider works too; pass --model to the CLI.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the model for every stage of a run at once -- policy,
# memory induction and prompt optimization. Useful for a cheap smoke test.
# META_EVOLVER_MODEL=gemini/gemini-3-flash
