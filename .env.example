# Meta-Evolver reads these at import time via a dependency-free .env loader.

# One of these is required for Gemini (the default chat and embedding provider).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Any provider with a LangChain integration works; pass --model to the CLI and
# install the matching extra, e.g. `pip install -e ".[openai]"`.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the chat model for every stage of a run at once -- policy,
# memory induction and prompt optimization. Useful for a cheap smoke test.
# META_EVOLVER_MODEL=google_genai:gemini-3-flash

# Optional: persist the memory bank in a database instead of a JSONL file.
# Postgres adds atomic credit assignment under concurrent rollouts and
# server-side vector search; Mongo adds durability and safe concurrent writes.
#   docker compose -f docker/docker-compose.yml up -d postgres
# META_EVOLVER_DB_URL=postgresql://meta:meta@localhost:5433/meta_evolver
# META_EVOLVER_DB_URL=mongodb://meta:meta@localhost:27018/meta_evolver?authSource=admin

# Optional: record the run's causal graph to Neo4j and watch it build.
#   docker compose -f docker/docker-compose.yml --profile graph up -d neo4j
#   open http://localhost:7475   (neo4j / evolution)
# META_EVOLVER_GRAPH_URL=bolt://neo4j:evolution@localhost:7688
